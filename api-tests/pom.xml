<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.rencity.qa</groupId>
    <artifactId>api-tests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Rencity QA - API automation tests</name>
    <description>
        Bộ test tự động gọi API thật (qua Gateway) để kiểm tra các luồng nghiệp vụ chính của
        Rencity: đăng ký/đăng nhập, hợp đồng thuê phòng, hoá đơn/chỉ số điện nước, ví tiền/rút
        tiền, CRM đặt lịch xem phòng. Chạy nhắm vào 1 môi trường thật (mặc định: Dev), không mock.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.2</junit.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <assertj.version>3.25.3</assertj.version>
        <slf4j.version>2.0.13</slf4j.version>

        <!-- Mặc định chạy nhắm Dev — đổi bằng `mvn test -Drencity.base-url=https://...` -->
        <rencity.base-url>https://api-dev.renapp.vn</rencity.base-url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- REST-assured cần 1 JSON serializer trên classpath để .body(Map/POJO) tự serialize
             request đi -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Các test gọi API thật qua network + phụ thuộc trạng thái theo đúng thứ tự
                         (vd tạo hợp đồng rồi mới thanh toán) -> KHÔNG chạy song song trong cùng 1
                         class, tránh đụng OTP cooldown / đá trạng thái lẫn nhau. -->
                    <parallel>none</parallel>
                    <systemPropertyVariables>
                        <rencity.base-url>${rencity.base-url}</rencity.base-url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
