# Copy thành .env (KHÔNG commit .env thật) trước khi build/chạy.
# Nhánh này chỉ có backend (api). Frontend nằm ở nhánh `frontend` của cùng repo này
# (github.com/nghiafullstack/qa_hub) — dashboard cần biết URL public của api này qua
# NEXT_PUBLIC_API_BASE_URL (xem .env.local.example bên nhánh frontend).

# MySQL chạy trên server RIÊNG (không phải container Docker của repo này) — tự tạo trước 1
# database/schema rỗng tên đúng DB_DATABASE + user có đủ quyền. Flyway tự tạo bảng khi API khởi
# động lần đầu, không cần chạy SQL tay.
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_DATABASE=qa_hub
DB_USERNAME=qa_hub
DB_PASSWORD=change-me

QAHUB_JWT_SECRET=change-me-toi-thieu-32-ky-tu-ngau-nhien
QAHUB_ADMIN_EMAIL=admin@yourcompany.com
QAHUB_ADMIN_PASSWORD=change-me

# GitHub PAT — chỉ cần nếu có dự án git_repo_url trỏ vào repo PRIVATE (đồng bộ tài liệu).
QAHUB_GITHUB_TOKEN=

# Origin thật của dashboard (nhánh frontend) khi deploy — dùng cho CORS.
QAHUB_WEB_ORIGIN=https://qa-hub.yourcompany.com

# Dùng lại đúng key Gemini đã có của module AI Chatbot bên rencity-platform-spring (xem README).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=180000
GEMINI_THINKING_LEVEL_ANALYSIS=minimal
GEMINI_ANALYSIS_MAX_OUTPUT_TOKENS=3072
GEMINI_TIMEOUT_RETRIES=1
